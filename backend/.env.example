# Copy to .env and fill in. Never commit .env.

PORT=3000
NODE_ENV=development
# Comma-separated list of allowed browser origins
CORS_ORIGINS=http://localhost:3000

# Required in production. Generate with: node -e "console.log(require('crypto').randomBytes(48).toString('base64url'))"
JWT_SECRET=
JWT_EXPIRES_IN=7d

# Data store: "memory" (default when SUPABASE_URL is empty) or "supabase"
DATA_STORE=
SUPABASE_URL=
# Server-side only. Never put this key in the mobile app.
SUPABASE_SERVICE_ROLE_KEY=

# SMS: "console" (development, prints codes to the server log) or "textbelt"
SMS_PROVIDER=console
TEXTBELT_KEY=

# Reverse geocoding via OpenStreetMap Nominatim
GEOCODE_ENABLED=true
